# ── Supabase ─────────────────────────────────────────────────────
# En local, los valores los imprime `npx supabase start`.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo en rutas de servidor y acciones. Nunca en código de cliente.
# Firma las URLs del almacén y crea las cuentas.
SUPABASE_SERVICE_ROLE_KEY=

# ── Almacenamiento ───────────────────────────────────────────────
# El bucket de Supabase Storage. Privado: todo acceso pasa por una URL
# firmada de vida corta que emite /api/download.
ALMACEN_BUCKET=acervo

# ── Claude API (sprint 3, pospuesto) ─────────────────────────────
# Sin ella, los metadatos se llenan a mano y la subida funciona igual.
ANTHROPIC_API_KEY=
