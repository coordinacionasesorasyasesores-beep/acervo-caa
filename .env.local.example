# ── Supabase ─────────────────────────────────────────────────────
# En local, los valores los imprime `npx supabase start`.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo en rutas de servidor. Nunca en código de cliente.
SUPABASE_SERVICE_ROLE_KEY=

# ── Cloudflare R2 (sprint 2) ─────────────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# ── Claude API (sprint 3) ────────────────────────────────────────
ANTHROPIC_API_KEY=
